# =============================================================================
# ReliefOps — Environment Variables
# Copy to apps/web/.env.local and apps/api/.env with real values for local dev
# =============================================================================

# ── Public (Next.js NEXT_PUBLIC_*) ───────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=relief-logistics.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=relief-logistics
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=relief-logistics.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://relief-logistics-rtdb.firebaseio.com
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── Server-side (injected via Secret Manager on Cloud Run) ───────────────────
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=
GCP_PROJECT_ID=relief-logistics
GCP_REGION=us-central1
FIREBASE_ADMIN_SA_JSON=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SENDGRID_API_KEY=
OPENWEATHER_API_KEY=
RELIEFWEB_API_KEY=
APP_CHECK_DEBUG_TOKEN=

# ── Emulator hosts (auto-detected when unset) ────────────────────────────────
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
FIREBASE_DATABASE_EMULATOR_HOST=localhost:9000
PUBSUB_EMULATOR_HOST=localhost:8085
