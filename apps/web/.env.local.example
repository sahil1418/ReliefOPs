# Copy to apps/web/.env.local with real values
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=relief-logistics.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=relief-logistics
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=relief-logistics.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://relief-logistics-rtdb.firebaseio.com
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Set to "true" for local emulator dev. MUST be "false" or unset in Vercel.
NEXT_PUBLIC_USE_EMULATORS=true

# ── Vercel deployment notes ─────────────────────────────────────────────────
# In the Vercel dashboard under Settings → Environment Variables:
#   NEXT_PUBLIC_API_BASE_URL=https://reliefops-api.onrender.com   (your Render URL)
#   NEXT_PUBLIC_USE_EMULATORS=false
#   NEXT_PUBLIC_FIREBASE_*  → real values from Firebase Console → Project Settings → SDK setup
#   NEXT_PUBLIC_GOOGLE_MAPS_API_KEY  → optional (Leaflet+OSM fallback works without it)
