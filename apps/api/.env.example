# Copy to apps/api/.env with real values for local dev
GCP_PROJECT_ID=relief-logistics
GCP_REGION=us-central1
ENV=local

# When using Firebase emulators, leave GOOGLE_APPLICATION_CREDENTIALS unset
# and the emulator hosts below will be auto-detected.
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
FIREBASE_DATABASE_EMULATOR_HOST=localhost:9000
PUBSUB_EMULATOR_HOST=localhost:8085

# Production (leave blank for local; injected via Secret Manager on Cloud Run)
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=
FIREBASE_ADMIN_SA_JSON=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SENDGRID_API_KEY=
OPENWEATHER_API_KEY=
RELIEFWEB_API_KEY=

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
