{
  "name": "relief-logistics",
  "version": "0.1.0",
  "private": true,
  "description": "ReliefOps — AI-Powered Humanitarian Disaster Logistics Platform (Google Solution Challenge 2026)",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@relief/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "api:dev": "cd apps/api && python -m uvicorn src.main:app --reload --port 8000",
    "api:install": "cd apps/api && python -m venv .venv && ./.venv/Scripts/pip install -r requirements.txt",
    "emulators": "firebase emulators:start --config infra/firebase.json --project relief-logistics",
    "seed": "tsx scripts/seed.ts"
  },
  "devDependencies": {
    "turbo": "2.1.3",
    "typescript": "5.6.3",
    "tsx": "4.19.1",
    "firebase-admin": "12.6.0",
    "@types/node": "22.7.5"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
